# Copy to .env (or export in your shell) before `docker compose up`.
TZ=Europe/Amsterdam

# Notifications
NTFY_MODE=http            # http | cli
NTFY_SERVER=https://ntfy.sh
NTFY_DEFAULT_TOPIC=pulsar-tracker
# NTFY_BIN=ntfy           # only for NTFY_MODE=cli

# Storage / runtime (defaults are fine inside compose)
# DATABASE_PATH=/data/pulsar.db
# REDIS_URL=redis://redis:6379
# PORT=3000
